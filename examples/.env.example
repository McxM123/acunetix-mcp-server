# Acunetix MCP Server 环境变量模板
# 复制本文件为 .env（或按需把变量写入系统环境 / MCP 客户端 environment 字段）

# ============ 必填（二选一） ============

# 方式一（推荐）：官方 API Key
# 获取路径：Acunetix 界面 → 右上角用户名 → Profile → API Key → Generate new API key → Copy
ACUNETIX_API_KEY=

# 方式二：账号密码（会话登录，有单会话约束）
ACUNETIX_EMAIL=
ACUNETIX_PASSWORD=

# ============ 可选 ============

# Acunetix 系统地址（本机 On-Premises 默认端口 3443）
ACUNETIX_BASE_URL=https://localhost:3443

# 自签名证书需为 false；生产环境使用受信证书可设为 true
ACUNETIX_VERIFY_SSL=false
